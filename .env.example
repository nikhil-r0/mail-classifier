# Model bundle identifier used when resolving files from the local cache layout
MAILSORT_MODEL_REPO_ID=jason23322/high-accuracy-email-classifier

# Root directory for cached model weights (see project .hfcache or your machine path)
HF_HUB_CACHE=/mnt/extra-maal/mail-classifier/.hfcache

# Optional: folder that already contains tokenizer JSON, .h5, and/or .tflite files
MAILSORT_MODEL_DIR=

# Inference mode: auto (prefer project model, else reference), custom, or baseline
MAILSORT_MODEL_MODE=auto

# When 1, only use files already on disk (no download attempts)
HF_HUB_OFFLINE=1
