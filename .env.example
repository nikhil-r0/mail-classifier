# Actual owner/repository on Hugging Face Hub, verified from cache metadata or repo page.
MAILSORT_MODEL_REPO_ID=jason23322/high-accuracy-email-classifier

# Root of the Hugging Face Hub cache.
# Example: /mnt/extra-maal/mail-classifier/.hfcache or /nikhil/.hfcache/huggingface/hub/hub
HF_HUB_CACHE=/mnt/extra-maal/mail-classifier/.hfcache

# Optional direct directory if files were downloaded using --local-dir, or if hub resolution is unavailable.
MAILSORT_MODEL_DIR=

# Optional application mode: 'custom' (3-class Primary/Promotions/Spam), 'baseline' (6-class HuggingFace), or 'auto'.
MAILSORT_MODEL_MODE=auto

# Set to 1 after all required assets are cached and offline operation is desired.
HF_HUB_OFFLINE=1
